{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Contract pin updates for a service-catalog implementation. Copy into the implementation repo and replace every __SERVICE__ with the service name: sed -i '' 's/__SERVICE__/orders/g' renovate.json. One-time setup: install the Renovate app and enable 'Allow auto-merge' on the repo, with branch protection requiring the contract-converge check.",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^contracts\\.lock$/"],
      "matchStrings": [
        "version: __SERVICE__\\/v(?<currentValue>[0-9.]+)\\s+sha: (?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "service-catalog/__SERVICE__",
      "packageNameTemplate": "https://github.com/hungovercoders/service-catalog",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^__SERVICE__/v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["service-catalog/__SERVICE__"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchDepNames": ["service-catalog/__SERVICE__"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["contract-major"]
    }
  ]
}
