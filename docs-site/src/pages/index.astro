---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Mermaid from '../components/Mermaid.astro';
import { services, edges, unconsumed, withBase } from '../lib/catalog';

const chart = [
  'flowchart LR',
  ...services.map((s) => `    ${s.name}[${s.title}]`),
  ...edges.map((e) => `    ${e.from} -- ${e.channel} --> ${e.to}`),
].join('\n');
---
<StarlightPage frontmatter={{ title: 'Service catalog' }}>
  <p>
    Contracts, acceptance criteria and docs for every service, generated from
    the <code>service.yaml</code> manifests. Gated artifacts are the contract
    of record; the
    <a href="https://github.com/hungovercoders/service-catalog">MCP server</a>
    serves the same catalog to agents.
  </p>

  <h2>Services</h2>
  <table>
    <thead>
      <tr><th>Service</th><th>Version</th><th>Domain</th><th>Owner</th><th>Summary</th></tr>
    </thead>
    <tbody>
      {services.map((s) => (
        <tr>
          <td><a href={withBase(`/services/${s.name}/`)}>{s.title}</a></td>
          <td>{s.version ?? '—'}</td>
          <td>{s.domain}</td>
          <td><code>{s.owner}</code></td>
          <td>{s.summary}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Event flow</h2>
  <Mermaid chart={chart} />

  {unconsumed.length > 0 && (
    <>
      <p>Channels with no consumer in the catalog:</p>
      <ul>
        {unconsumed.map((u) => (
          <li><code>{u.channel}</code> (produced by {u.producer})</li>
        ))}
      </ul>
    </>
  )}
</StarlightPage>
