---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, Card } from '@astrojs/starlight/components';
import Mermaid from '../components/Mermaid.astro';
import { services, indexGraph, withBase } from '../lib/catalog';
---
<StarlightPage frontmatter={{ title: 'Service catalog' }}>
  <p>
    Contracts, acceptance criteria and docs for every service, generated from
    the <code>service.yaml</code> manifests. Gated artifacts are the contract
    of record; the
    <a href="https://github.com/hungovercoders/service-catalog">MCP server</a>
    serves the same catalog to agents.
  </p>

  <h2>Services</h2>
  <CardGrid>
    {services.map((s) => (
      <Card title={s.title} icon="open-book">
        <p><a href={withBase(`/services/${s.name}/`)}><strong>{s.title}</strong></a></p>
        <p>{s.summary}</p>
        <p>
          <code>v{s.version ?? '—'}</code> · {s.domain} · <code>{s.owner}</code>
        </p>
      </Card>
    ))}
  </CardGrid>

  <h2>Message flow</h2>
  <Mermaid chart={indexGraph} />
</StarlightPage>
