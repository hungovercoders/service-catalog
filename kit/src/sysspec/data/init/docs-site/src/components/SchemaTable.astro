---
import type { SchemaRow } from '../lib/specs';

interface Props {
  rows: SchemaRow[];
}
const { rows } = Astro.props;
---
{rows.length > 0 && (
  <table>
    <thead>
      <tr><th>Field</th><th>Type</th><th>Required</th><th>Constraints</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td><code>{r.field}</code></td>
          <td>{r.type}</td>
          <td>{r.required ? 'yes' : 'no'}</td>
          <td>{r.constraints || '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
)}
