---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import { Code } from 'astro:components';
import { marked } from 'marked';
import AsyncApi from '../../../components/AsyncApi.astro';
import ContractOfRecord from '../../../components/ContractOfRecord.astro';
import GherkinSteps from '../../../components/GherkinSteps.astro';
import OdcsContract from '../../../components/OdcsContract.astro';
import OpenApi from '../../../components/OpenApi.astro';
import VersionHistory from '../../../components/VersionHistory.astro';
import { artifactUrl, hasMessages, services, withBase } from '../../../lib/specs';
import type { Artifact, Service } from '../../../lib/specs';

export function getStaticPaths() {
  const paths = [];
  for (const s of services) {
    for (const a of s.artifacts) {
      if (a.kind === 'feature') continue;
      paths.push({ params: { service: s.name, page: a.stem }, props: { service: s, artifact: a } });
    }
    const features = s.artifacts.filter((a) => a.kind === 'feature');
    if (features.length) {
      paths.push({ params: { service: s.name, page: 'features' }, props: { service: s, features } });
    }
    if (s.changelog.length) {
      paths.push({ params: { service: s.name, page: 'changelog' }, props: { service: s, changelog: true } });
    }
  }
  return paths;
}

interface Props {
  service: Service;
  artifact?: Artifact;
  features?: Artifact[];
  changelog?: boolean;
}

const { service, artifact, features, changelog } = Astro.props;

const titles: Record<string, string> = {
  openapi: `${service.title} — HTTP contract`,
  asyncapi: `${service.title} — event contract`,
  'data-contract': `${service.title} — ${artifact?.odcs?.name ?? artifact?.stem}`,
};

// Doc artifacts (ADRs, runbooks) carry their own h1; lift it into the page title.
let docTitle = artifact?.label ?? artifact?.stem ?? '';
let docHtml = '';
if (artifact?.kind === 'doc') {
  const text = artifact.text ?? '';
  const heading = text.match(/^#\s+(.+)$/m);
  docHtml = await marked.parse(heading ? text.replace(heading[0], '') : text);
}

const title = changelog
  ? `${service.title} — changelog`
  : features
    ? `${service.title} — acceptance criteria`
    : titles[artifact!.kind] ?? docTitle;

const showReference =
  artifact && artifact.kind !== 'doc' && hasMessages(service);
const messagesHref = withBase(`/services/${service.name}/messages/`);
---
<StarlightPage frontmatter={{ title }}>
  {changelog && (
    <>
      <p>
        Release history from the <code>{service.name}/v&lt;version&gt;</code> tags
        cut on merge to main; each entry lists the commits that touched
        <code>specs/{service.name}/</code>.
      </p>
      {service.changelog.map((r) => (
        <>
          <h2>
            v{r.version}
            {r.unreleased ? ' — unreleased' : r.date ? ` — ${r.date}` : ''}
          </h2>
          <ul>{r.commits.map((c) => <li>{c}</li>)}</ul>
        </>
      ))}
    </>
  )}

  {features &&
    features.map((a) => {
      const f = a.feature!;
      const count = f.scenarios.length;
      return (
        <>
          <h2>{f.title}</h2>
          <p>
            <strong>{count} scenario{count === 1 ? '' : 's'}</strong> — binding,
            versioned at {a.version} — contract of record:{' '}
            <a href={artifactUrl(service.name, a)}><code>{a.path}</code></a>
          </p>
          <VersionHistory artifact={a} />
          {f.description.length > 0 && <p>{f.description.join(' ')}</p>}
          {f.background.length > 0 && (
            <Aside type="note" title="Background">
              <GherkinSteps steps={f.background} />
            </Aside>
          )}
          {f.scenarios.map((sc) => (
            <>
              <h3>{sc.title}</h3>
              <div class="sc-scenario">
                <GherkinSteps steps={sc.steps} />
              </div>
            </>
          ))}
          <details>
            <summary>Raw Gherkin</summary>
            <Code code={a.text ?? ''} lang="gherkin" />
          </details>
        </>
      );
    })}

  {artifact && artifact.kind !== 'doc' && (
    <ContractOfRecord service={service.name} artifact={artifact} />
  )}
  {artifact && artifact.gated && <VersionHistory artifact={artifact} />}
  {showReference && (
    <p>Readable message reference: <a href={messagesHref}>Messages</a>.</p>
  )}

  {artifact?.kind === 'openapi' && <OpenApi url={artifactUrl(service.name, artifact)} />}
  {artifact?.kind === 'asyncapi' && <AsyncApi url={artifactUrl(service.name, artifact)} />}
  {artifact?.kind === 'data-contract' && (
    <OdcsContract odcs={artifact.odcs} erMermaid={artifact.er_mermaid} />
  )}
  {artifact?.kind === 'doc' && <Fragment set:html={docHtml} />}
</StarlightPage>
