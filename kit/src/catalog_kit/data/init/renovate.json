{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Taskfile\\.yml$/", "/^\\.mcp\\.json$/"],
      "matchStrings": ["catalog-kit==(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "catalog-kit",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["catalog-kit"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
